{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/pre_tool_use.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/pre_tool_use.py\"",
            "timeout": 3,
            "statusMessage": "Checking active VulnGate audit scope"
          }
        ]
      }
    ]
  }
}
